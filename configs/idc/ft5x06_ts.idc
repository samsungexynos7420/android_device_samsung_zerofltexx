# Input Device Calibration File for the touch screen.

# Internal Device Flag
device.internal = 1

# Touch Parameters
touch.deviceType = touchScreen
touch.orientationAware = 1

# Touch Size Calibration
# Calibration for touch size is based on area measurement.
touch.size.calibration = area
touch.size.scale = 52
touch.size.bias = 11.8
touch.size.isSummed = 0

# Pressure Calibration
# Calibration for touch pressure is based on amplitude.
touch.pressure.calibration = amplitude
touch.pressure.scale = 0.015

# Orientation Calibration
# Calibration for touch orientation is vector.
touch.orientation.calibration = vector
